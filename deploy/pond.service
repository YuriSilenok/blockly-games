[Unit]
Description=Pond school and tournament
After=network.target

[Service]
User=pond
Group=pond
WorkingDirectory=/opt/pond
EnvironmentFile=/etc/pond.env
ExecStart=/opt/pond-venv/bin/python -m server.app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pond
MemoryMax=640M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
